# 复制为 .env 并填入真值：cp .env.example .env
# .env 已在 .gitignore 中，不会被提交。仓库是公开的，凭证千万别写进别的文件。

# ---- Cloudflare 凭证（二选一，DRY_RUN=1 时不需要）----
# 方式一：API Token（推荐，需 Workers 写权限）
CF_API_TOKEN=
# 方式二：Global API Key + 账号邮箱
CF_API_EMAIL=
CF_API_KEY=
CF_ACCOUNT_ID=

# ---- 可选参数 ----
# 订阅源路径，默认 ./pages/c_deploy/sub.yaml
SUB_YAML=
# worker 源文件，默认 ./dy_worker.js
DY_WORKER_JS=
# worker 名，默认 dy
CF_WORKER_NAME=
# compatibility_date，默认自动读取线上现有值
CF_COMPAT_DATE=
# 自有服务器域名白名单，逗号分隔；节点的 server/servername/sni/host 任一精确
# 等于其中一项即入选。换服务器时改这里。
DY_DOMAINS=aws.sbbz.tech,awsvx2083.sbbz.tech
# 显式节点名白名单，逗号分隔；设了就忽略 DY_DOMAINS
DY_NODES=
# 节点未指定 client-fingerprint 时的默认值
DY_DEFAULT_FP=chrome
# 设为 1：只生成并打印，不写文件、不部署
DRY_RUN=
